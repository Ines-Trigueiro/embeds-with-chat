# Copy to .env and fill in your key:  cp .env.example .env

# Required: key for the default model below.
ANTHROPIC_API_KEY=

# Any "provider:model" string supported by LangChain's init_chat_model.
# Other providers need their LangChain package added (see the README).
LLM_MODEL=anthropic:claude-sonnet-5-5

# Where the two origins are reachable from the browser. They must differ (ADR 0001).
APP_ORIGIN=http://localhost:8000
EMBED_ORIGIN=http://localhost:8001

# Where SQLite and uploaded files are stored. Compose mounts a volume here.
DATA_DIR=/data

# How long a signed preview URL for an unpublished version stays valid, in seconds.
PREVIEW_TTL_SECONDS=86400

# Optional: LangSmith tracing turns on only when a key is set.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=embeds-with-chat
